{
  "name": "panel-duwoh",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run db:up && concurrently -k -n api,web -c blue,magenta \"npm run dev -w @duwoh/api\" \"npm run dev -w @duwoh/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @duwoh/api",
    "db:seed": "npm run db:seed -w @duwoh/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
