# Copiar a .env y completar. .env NUNCA se commitea.
# Un único .env en la raíz lo leen Docker Compose, la API y la web.

# ── Postgres local (Docker Compose) ───────────────────────────────
POSTGRES_USER=duwoh
POSTGRES_PASSWORD=
POSTGRES_DB=panel_duwoh
POSTGRES_PORT=5432

# ── API ───────────────────────────────────────────────────────────
# NODE_ENV no va acá: Vite lo leería y haría builds de desarrollo. Lo define cada script / Railway.
API_PORT=3000
# URL pública de la API. Prod: https://api.duwohdevelopers.com
API_URL=http://localhost:3000
# Origen del front (CORS + verificación de Origin). Prod: https://panel.duwohdevelopers.com
WEB_ORIGIN=http://localhost:5173
# Dominio de las cookies. Vacío en local; prod: .duwohdevelopers.com
COOKIE_DOMAIN=

# postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE (la de tests termina en _test)
DATABASE_URL=
DATABASE_URL_TEST=

# Secreto para firmar los JWT de acceso (mínimo 32 caracteres).
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=

# ── Google OAuth (Google Cloud Console → Credenciales) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Prod: https://api.duwohdevelopers.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Seed de administradores (npm run db:seed) ─────────────────────
SEED_ADMIN_1_NAME=
SEED_ADMIN_1_EMAIL=
SEED_ADMIN_1_PASSWORD=
SEED_ADMIN_2_NAME=
SEED_ADMIN_2_EMAIL=
SEED_ADMIN_2_PASSWORD=

# ── Web (Vite) ────────────────────────────────────────────────────
# Solo las VITE_* llegan al navegador: nunca poner secretos acá.
VITE_API_URL=http://localhost:3000
